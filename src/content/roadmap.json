{
  "stages": [
    {
      "id": "js-foundation",
      "title": "JS 기초 다지기",
      "level": "입문",
      "goal": "값·스코프·클로저·this·프로토타입을 그림으로 설명할 수 있다",
      "docs": [
        "js-ts/js-basics",
        "js-ts/functions-closure",
        "js-ts/objects-prototype",
        "js-ts/modern-js"
      ]
    },
    {
      "id": "js-runtime",
      "title": "JS 런타임 이해",
      "level": "중급",
      "goal": "비동기 코드의 실행 순서를 이벤트 루프로 예측할 수 있다",
      "docs": [
        "js-ts/iterators-generators",
        "js-ts/async",
        "js-ts/event-loop",
        "js-ts/modules"
      ]
    },
    {
      "id": "typescript",
      "title": "TypeScript",
      "level": "중급 → 심화",
      "goal": "제네릭·조건부 타입·infer로 재사용 가능한 타입을 직접 만든다",
      "docs": [
        "js-ts/ts-basics",
        "js-ts/typescript",
        "js-ts/ts-type-level"
      ]
    },
    {
      "id": "nest-core",
      "title": "NestJS 핵심 구조",
      "level": "중급",
      "goal": "Module·Provider·데코레이터가 DI 컨테이너 안에서 어떻게 맞물리는지 설명할 수 있다",
      "docs": [
        "nestjs/module",
        "nestjs/provider",
        "nestjs/decorators-metadata"
      ]
    },
    {
      "id": "nest-request",
      "title": "요청 처리 파이프라인",
      "level": "중급",
      "goal": "요청 하나가 Guard·Pipe·Interceptor·Filter를 거치는 길을 직접 설계한다",
      "docs": [
        "nestjs/lifecycle",
        "nestjs/controllers",
        "nestjs/validation",
        "nestjs/exceptions",
        "nestjs/auth"
      ]
    },
    {
      "id": "nest-practice",
      "title": "NestJS 실전",
      "level": "심화",
      "goal": "DB·테스트·비동기 작업·서비스 간 통신을 NestJS 방식으로 구성한다",
      "docs": [
        "nestjs/database",
        "nestjs/testing",
        "nestjs/background",
        "nestjs/microservices"
      ]
    },
    {
      "id": "nest-deep",
      "title": "아키텍처와 내부 동작",
      "level": "심화",
      "goal": "패턴을 골라 쓰고, 막히면 NestJS 소스를 열어 원인을 찾는다",
      "docs": [
        "nestjs/patterns",
        "nestjs/internals",
        "nestjs/tips"
      ]
    },
    {
      "id": "interview",
      "title": "면접 대비",
      "level": "실전",
      "goal": "단골 질문에 1분 안에 답하고, 꼬리 질문이 오면 직접 코드로 구현해 보인다",
      "docs": [
        "interview/javascript",
        "interview/javascript-implement",
        "interview/typescript",
        "interview/typescript-implement",
        "interview/nestjs",
        "interview/nestjs-implement"
      ]
    }
  ]
}